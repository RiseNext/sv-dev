# dependencies
node_modules/

# next.js build output — .next-* covers the NEXT_DIST_DIR verification builds
# described in the README (e.g. .next-verify)
.next/
.next-*/
out/
build/

# env — never commit secrets; Vercel holds the real values as project env vars
.env
.env.*
!.env.example

# typescript — both are regenerated by `next build`
next-env.d.ts
*.tsbuildinfo

# vercel CLI link + local pulled env
.vercel

# hero video preview — LOCAL TEST FOOTAGE ONLY. The real source is the CMS's
# site-settings.heroVideos field; this folder exists so the layout can be judged
# before that ships. Ignored because the files are large binaries AND because
# public/ is served in production, so a committed clip is one that could ship.
public/media/hero/*
!public/media/hero/README.md

# misc
.DS_Store
Thumbs.db
*.pem
npm-debug.log*
yarn-error.log*
