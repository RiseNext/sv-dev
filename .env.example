# =============================================================================
# svfrontend/.env.example — copy to .env.local
#
# This repository had ZERO environment variables before CMS integration.
# =============================================================================

# Where the CMS public API lives. Used by the server-side data layer at build
# and revalidate time, AND by ContactForm in the BROWSER — which is why it must
# carry the NEXT_PUBLIC_ prefix. It holds a public URL, so exposure is correct.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1

# The origin that serves uploaded media. Added to images.remotePatterns.
# Leave EMPTY in local development: uploads fall back to the CMS's own origin,
# which next.config.mjs derives from NEXT_PUBLIC_API_BASE_URL.
#
# 🔶 PRODUCTION: this is CLOUDINARY's delivery host, NOT a subdomain of the site
# (owner decision, 20 Sep 2026 — svbackend/docs/PRODUCTION-CONFIG.md §3):
#     https://res.cloudinary.com/<cloud name>
# It must byte-match whatever the backend resolves as its delivery base, or every
# next/image call site throws "hostname is not configured" — a build failure, not
# a degraded image.
NEXT_PUBLIC_MEDIA_BASE_URL=

# Replaces the hardcoded `site.url = 'https://www.example.com'`, which made
# every canonical URL, every OpenGraph url and every sitemap entry wrong.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 🔴 SERVER-ONLY. NEVER prefix this with NEXT_PUBLIC_ — that would publish the
# secret in the browser bundle. Must be BYTE-IDENTICAL to the backend's value,
# or every revalidation is rejected with a 401 that only the job log sees:
# content appears to publish and the site silently never updates.
REVALIDATE_SECRET=

# Lifts BOTH indexing blocks together: robots.ts's `disallow: '/'` AND
# layout.tsx's `robots: { index: false }`. Lifting only one leaves the site
# unindexed with a non-obvious cause.
# 🔴 This is the single most consequential launch action in the project.
NEXT_PUBLIC_ALLOW_INDEXING=false
